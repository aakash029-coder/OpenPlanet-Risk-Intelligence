# ──────────────────────────────────────────────────────────────────────────────
# OpenPlanet Climate Risk Engine — Environment Variable Reference
# Copy this file to .env (backend) and frontend/.env.local (frontend).
# Never commit files containing real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# ── BACKEND: climate_engine ───────────────────────────────────────────────────

# Runtime mode: development | production (enforces HSTS and error sanitization in production)
ENV_MODE=development
LOG_LEVEL=INFO

# Rate limiting (requests per minute per IP via SlowAPI)
RATE_LIMIT_PER_MINUTE=100

# CORS origins (comma-separated origins allowed to make browser requests)
CORS_ORIGINS=http://localhost:3000

# Secret key for internal cryptographic operations (min 32 characters in production)
SECRET_KEY=change_this_to_a_strong_random_secret_min_32_chars

# API Key authentication (comma-separated allowed keys; empty = disabled/open dev mode)
API_KEYS=

# Disk cache configuration (stores ERA5 bundles & CMIP6 model series)
# Defaults to climate_engine/data/cache
OPENPLANET_CACHE_DIR=
OPENPLANET_CACHE_MAX_FILES=5000

# Edge proxy tunnel URL (optional anti-throttling proxy for shared cloud outbound IPs)
# Production: set to https://your-domain.com/api/tunnel (or Cloudflare Workers / Nginx)
# Local dev: leave unset to call upstream APIs directly
VERCEL_TUNNEL_URL=

# ── OPTIONAL LLM ANALYSIS PROVIDER ────────────────────────────────────────────
# Provider-neutral OpenAI-compatible LLM client used for /api/research-analysis.
# AI is strictly optional; core physics and climate calculations run without it.
GROQ_API_KEY=gsk_placeholder_groq_api_key
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# ── OPTIONAL COMMERCIAL WEATHER FALLBACK TIERS ─────────────────────────────────
# Secondary/tertiary historical weather tiers in climate_engine/services/historical_service.py.
# Open-Meteo ERA5 (Tier 1) and NASA POWER (Tier 4) require no API keys.
WEATHERSTACK_API_KEY=
METEOSTAT_API_KEY=
VISUAL_CROSSING_API_KEY=

# ── DEPLOYMENT SCRIPTS ────────────────────────────────────────────────────────
# Hugging Face write token for scripts/deploy_hf.py (never commit real value)
HF_TOKEN=hf_placeholder_token

# ── FRONTEND: Next.js (frontend/.env.local) ───────────────────────────────────

# Base URL of the running FastAPI engine (no trailing slash)
# Local: http://localhost:7860 | Hugging Face: https://albus2903-openplanet-engine.hf.space
NEXT_PUBLIC_ENGINE_URL=http://localhost:7860

# Optional Google Analytics ID (disabled by default; requires explicit opt-in consent)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Map Style URL (defaults to CARTO basemaps)
NEXT_PUBLIC_MAP_STYLE_URL=

# ── CONTACT FORM & PRIVACY INQUIRIES DELIVERY ────────────────────────────────
# Submissions via /support are validated on the server and forwarded to a configured
# gateway. If none are configured, the API safely returns HTTP 503 (no data stored).
CONTACT_WEBHOOK_URL=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=OpenPlanet <noreply@openplanetrisk.com>
CONTACT_FORMSPREE_ENDPOINT=

# ── OPTIONAL AUTHENTICATION: NextAuth.js ───────────────────────────────────────
# Authentication is strictly optional. All core climate intelligence routes are public.
NEXTAUTH_SECRET=change_this_to_a_random_32_byte_secret
NEXTAUTH_URL=http://localhost:3000

# Optional Identity Providers (Google OAuth, Keycloak, Authentik, OIDC)
# Frontend default sign-in provider ID (default: google)
NEXT_PUBLIC_AUTH_PROVIDER_ID=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ISSUER=

